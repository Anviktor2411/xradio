[Unit]
Description=XRadio relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xradio
WorkingDirectory=/opt/xradio/server
ExecStart=/usr/bin/python3 /opt/xradio/server/server.py --host 0.0.0.0 --port 49100
Restart=always
RestartSec=3

# basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
